# Ladder backend configuration. Copy to .env for local dev; set the same
# variables in the Vercel project for production. The site's content pages
# (units, calculator, maps) need none of this — only the ladder does.

# Postgres connection — Supabase's shared transaction-mode pooler (IPv4,
# port 6543). Only server functions ever read this; the browser has no
# database access at all. On Vercel the Supabase integration's injected
# POSTGRES_URL works as a fallback, so this can be omitted there.
DATABASE_URL=postgresql://postgres.your-project:password@aws-1-eu-west-1.pooler.supabase.com:6543/postgres

# Steam Web API key (https://steamcommunity.com/dev/apikey) — used to fetch
# persona names and avatars after sign-in. Sign-in works without it, with
# placeholder names.
STEAM_API_KEY=

# Signs the session JWT. Any random string of 32+ chars.
SESSION_SECRET=

# The canonical public origin. Steam's OpenID realm derives from this, so
# sign-in only works on exactly this origin (previews/other domains will 403).
# Local dev: http://localhost:5173
SITE_URL=http://localhost:5173
