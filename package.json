{
  "name": "sanctuarydb",
  "version": "0.1.0",
  "private": true,
  "description": "SanctuaryDB — unit database and calculators for Sanctuary: Shattered Sun, generated from the game files",
  "type": "module",
  "//": "`build` only bundles the site — it never touches the game install. `extract`/`icons`/`refresh` are the local-only scripts that need the game.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "extract": "node scripts/extract.js",
    "addmap": "node scripts/add-map.js",
    "icons": "node scripts/build-icons.js",
    "refresh": "npm run extract && npm run icons && npm run diff",
    "verify": "node scripts/verify.js",
    "db:migrate": "node scripts/db-migrate.js",
    "test": "vitest run",
    "diff": "node scripts/diff-data.js",
    "test:e2e": "playwright test",
    "test:modding-versions": "node scripts/test-modding-versions.js",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "jose": "^6.2.10",
    "nitro": "^3.0.260610-beta",
    "postgres": "^3.4.9",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.62.1",
    "@types/mdx": "^2.0.14",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "eslint": "^10.8.1",
    "eslint-plugin-react-hooks": "^7.1.1",
    "fumadocs-core": "^16.15.6",
    "fumadocs-mdx": "^15.4.0",
    "prettier": "^3.9.6",
    "serve": "^14.2.6",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1",
    "vitest": "^4.1.11",
    "zod": "^4.5.4"
  }
}
