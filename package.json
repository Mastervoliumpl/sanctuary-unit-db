{
  "name": "sanctuarydb",
  "version": "0.1.0",
  "private": true,
  "description": "SanctuaryDB — unit database and calculators for Sanctuary: Shattered Sun, generated from the game files",
  "type": "module",
  "//": "`build` only bundles the site — it never touches the game install. `extract`/`icons`/`refresh` are the local-only scripts that need the game.",
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "typecheck": "tsc --noEmit",
    "extract": "node scripts/extract.js",
    "icons": "node scripts/build-icons.js",
    "refresh": "npm run extract && npm run icons && npm run diff",
    "verify": "node scripts/verify.js",
    "test": "vitest run",
    "diff": "node scripts/diff-data.js"
  },
  "engines": {
    "node": ">=22.12"
  },
  "dependencies": {
    "@tanstack/react-router": "^1.170.31",
    "@tanstack/react-start": "^1.168.48",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "typescript": "^5.9.3",
    "vite": "^8.2.1",
    "vitest": "^4.1.11"
  }
}
